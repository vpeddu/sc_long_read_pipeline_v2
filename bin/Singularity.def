Bootstrap: docker
From: ubuntu:22.04

%labels
    Author "Vikas Peddu"
    Version v1.3.1
    Description "Container for long-read isoform analysis pipeline"
    Website https://github.com/broadinstitute/long-reads

%files
    bin/env_specs /opt/env_specs

%environment
    export PATH="/opt/miniconda3/bin:$PATH"
    export CONDA_DIR="/opt/miniconda3"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONPATH="/opt/cDNA_Cupcake/sequence:$PYTHONPATH"
%post
    set -e

    # `singularity build` has no --cleanenv flag, so %post inherits whatever
    # conda/PATH state exists on the HOST running the build. If the host has
    # its own conda install ahead on PATH, package post-link scripts here can
    # silently pick up the host's conda instead of this container's, breaking
    # in confusing ways deep into the build (confirmed root cause of a
    # "No compatible shell found!" failure during a later environment's
    # install). Reset PATH and clear conda's env vars before anything else.
    unset CONDA_EXE CONDA_PREFIX CONDA_PYTHON_EXE CONDA_DEFAULT_ENV CONDA_SHLVL CONDA_PROMPT_MODIFIER _CE_CONDA
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

    # Set non-interactive mode for apt and debconf to prevent prompts
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

    export SHELL=/bin/bash

    # Update package manager
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        wget \
        bzip2 \
        libz-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libncurses5-dev \
        samtools \
        bedtools \
        openjdk-11-jre-headless \
        r-base \
        r-base-dev \
        perl \
        perl-modules \
        libperl-dev \
        vim \
        less \
        gawk \
        sed \
        grep \
        bc \
        time \
        python3-pip \
        pigz \
        samtools \
        bedtools 

    # Install Miniconda (try multiple URLs and validate the downloaded file)
    CONDA_VERSION="23.11.0"
    MINICONDA_URLS="https://repo.anaconda.com/miniconda/Miniconda3-${CONDA_VERSION}-Linux-x86_64.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh"
    DOWNLOADED=0
    for url in $MINICONDA_URLS; do
        echo "Attempting to download Miniconda installer from: $url"
        # use -f to fail on HTTP errors, -S show errors, -L follow redirects, set UA to avoid basic blocking
        curl -fSL -A "Mozilla/5.0 (X11; Linux x86_64)" "$url" -o /tmp/miniconda.sh || { echo "curl failed for $url"; rm -f /tmp/miniconda.sh; continue; }
        # Quick sanity check: file should start with a shell shebang
        if head -n1 /tmp/miniconda.sh | grep -q '^#!'; then
            DOWNLOADED=1
            break
        else
            echo "Downloaded file from $url did not look like a shell script; trying next URL"
            rm -f /tmp/miniconda.sh
        fi
    done
    if [ "$DOWNLOADED" -ne 1 ]; then
        echo "ERROR: Failed to download a valid Miniconda/Miniforge installer."
        echo "Check network access or update Singularity.def to point to a local installer."
        exit 1
    fi
    /bin/bash /tmp/miniconda.sh -b -p /opt/miniconda3
    rm -f /tmp/miniconda.sh
    
    # Initialize conda and install mamba
    /opt/miniconda3/bin/conda init bash
    /opt/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    /opt/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    /opt/miniconda3/bin/conda install -y -n base -c conda-forge mamba
    /opt/miniconda3/bin/conda config --system --prepend channels conda-forge
    /opt/miniconda3/bin/conda config --system --prepend channels bioconda
    /opt/miniconda3/bin/conda config --system --set auto_update_conda false
    /opt/miniconda3/bin/conda config --system --set show_channel_urls true
    # Ensure mamba can reuse the same configuration
    /opt/miniconda3/bin/mamba config --show > /dev/null 2>&1 || true
    
    # Create environments with mamba
    
    # Environment 1: long_reads (for HTSeq, longshot, basic tools)
    # All conda-native environments below are created via `conda create --file`
    # from an @EXPLICIT spec (exact package+build+channel URLs, see bin/env_specs/),
    # captured from the already-validated v1.0.0 image. This installs the full,
    # already-known-compatible package set with no solving at all -- version-only
    # or even version+build pins on just the top-level requested packages were not
    # enough, since their unpinned transitive dependencies (e.g. htslib, perl-*)
    # could still resolve to a different, mutually-incompatible combination.
    /opt/miniconda3/bin/conda create -y -n long_reads --file /opt/env_specs/long_reads.explicit.txt
    /opt/miniconda3/bin/mamba run -n long_reads pip install --upgrade pip
    /opt/miniconda3/bin/mamba run -n long_reads pip install \
        htseq \
        pysam \
        pandas \
        numpy \
        scipy \
        biopython \
        bcbio-gff \
        pyyaml \
        seqtk \
        polars \
        gtfparse

    # Environment 2: flair
    # Pinned to 3.0.0 (latest as of this writing) for the `flair transcriptome`
    # module, which replaces the old correct+collapse pipeline with a single
    # faster, lower-memory step run directly off the aligned/indexed genome bam.
    # Spec captured from an isolated test build, since v1.0.0 predates this upgrade.
    /opt/miniconda3/bin/conda create -y -n flair --file /opt/env_specs/flair.explicit.txt
    /opt/miniconda3/bin/mamba run -n flair pip install --upgrade pip

    # Environment 4: vep (for variant annotation)
    /opt/miniconda3/bin/conda create -y -n vep --file /opt/env_specs/vep.explicit.txt

    /opt/miniconda3/bin/conda create -y -n picardtools --file /opt/env_specs/picardtools.explicit.txt
    # # Install Picard tools
    # PICARD_VERSION="3.0.0"
    # mkdir -p /opt/picard
    # cd /opt/picard
    # curl -sSL -O "https://github.com/broadinstitute/picard/releases/download/${PICARD_VERSION}/picard.jar"
    # chmod +x picard.jar

   /opt/miniconda3/bin/conda create -y --name isoSeQL --file /opt/env_specs/isoSeQL.explicit.txt

    # Install additional R packages
/opt/miniconda3/bin/conda create -y -n bioconductor --file /opt/env_specs/bioconductor.explicit.txt

    # Environment: seurat (Seurat + tximport, for the per-sample gene+isoform
    # Seurat object build in runBuildSeurat). Kept separate from the much older
    # R 3.5.1 bioconductor env above -- Seurat requires R>=4.0, and giving it
    # its own env avoids re-solving/risking that already-pinned environment.
    /opt/miniconda3/bin/conda create -y -n seurat --file /opt/env_specs/seurat.explicit.txt

    # Environment: salmon (short-read quantification against the per-sample
    # novel long-read transcriptome, D01_shortread.nf's runShortReadQuant).
    # Its own env rather than sqanti3's (which already has kallisto/STAR for
    # its own internal QC use) to avoid re-solving/risking that pinned env.
    /opt/miniconda3/bin/conda create -y -n salmon --file /opt/env_specs/salmon.explicit.txt



# wget --no-check-certificate https://github.com/christine-liu/SQANTI3/archive/refs/tags/v1.00CL.zip
# mkdir sqanti3

# unzip v1.00CL.zip -d sqanti3
# mv sqanti3/SQANTI3-1.00CL/* sqanti3/

# wget --no-check-certificate https://raw.githubusercontent.com/ConesaLab/SQANTI3/refs/heads/master/SQANTI3.conda_env.yml
# mv SQANTI3.conda_env.yml sqanti3/


# /opt/miniconda3/bin/mamba env create -y -f sqanti3/SQANTI3.conda_env.yml

# /opt/miniconda3/bin/mamba install -y -n sqanti3 -c conda-forge python=3.10 --force-reinstall

# /opt/miniconda3/bin/mamba install -y -n sqanti3 -c conda-forge -c plotly -c anaconda -c bioconda\
#     r-base=4.1.1 \
#     r-devtools \
#     plotly \
#     pandas \
#     numpy \
#     python-kaleido \
#     setuptools \
#     cdna_cupcake
# Download custom SQANTI3 (Christine Liu fork for isoSeQL)
wget --no-check-certificate https://github.com/christine-liu/SQANTI3/archive/refs/tags/v1.00CL.zip
mkdir sqanti3
unzip v1.00CL.zip -d sqanti3
mv sqanti3/SQANTI3-1.00CL/* sqanti3/

# Create unified environment with Python 3.10 (required for cDNA_Cupcake) and
# install all SQANTI3 dependencies from the pinned explicit spec in one shot --
# this environment's R+Bioconductor+Python dependency graph is by far the
# slowest thing for mamba to solve when unpinned or only partially pinned.
/opt/miniconda3/bin/conda create -y -n sqanti3 --file /opt/env_specs/sqanti3.explicit.txt

    /opt/miniconda3/bin/mamba run -n sqanti3 Rscript -e 'devtools::install_github("ConesaLab/RColorConesa")'

# Remove the separate isoSeQL environment creation (it uses sqanti3 env instead)
git clone https://github.com/christine-liu/isoSeQL

wget --no-check-certificate https://raw.githubusercontent.com/christine-liu/SQANTI3/refs/heads/master/sqanti3_filter.py

git clone https://github.com/ConesaLab/SQANTI3
mv SQANTI3/src/ .

    # Create wrapper script for conda activation
    mkdir -p /opt/bin
    cat > /opt/bin/run_with_conda.sh << 'EOF'
#!/bin/bash
# Helper script to run commands in conda environments
ENV_NAME=$1
shift
source /opt/miniconda3/bin/activate $ENV_NAME
exec "$@"
EOF
    chmod +x /opt/bin/run_with_conda.sh
    
    # Clean up
    /opt/miniconda3/bin/conda clean --all --yes
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec "$@"

%help
    This container provides all necessary tools for long-read isoform analysis pipeline.
    
    Available conda environments:
    - long_reads: HTSeq, longshot, minimap2, samtools, bedtools, seqtk
    - flair: flair isoform discovery tool
    - sqanti3: SQANTI3 isoform QC tool
    - vep: Variant annotation tools
    - seurat: Seurat + tximport, for per-sample Seurat object construction
    - salmon: salmon + alevin-fry, for single-cell short-read quantification against the novel long-read transcriptome

    To use a specific conda environment:
    singularity exec container.sif bash -c 'source activate ENV_NAME && YOUR_COMMAND'

params {
    multiseq = false
    use_container = true  // Set to false to use local conda environments instead
    container = 'oras://ghcr.io/vpeddu/sc_long_pipeline:v1.0.0'
    minimap2_split = 4  // declared here (not cast in main.nf) so Nextflow coerces --minimap2_split CLI strings to int
}

process {
    // Enable Singularity container only if use_container is true
    container = params.use_container ? params.container : null

    // Centralized resource settings moved out of module files.
    // runFlexiplex/runMinimap2 now run once per fastq chunk (params.minimap2_split
    // chunks in parallel per sample) rather than once per full sample. Memory below
    // is sized per chunk, not per sample -- minimap2 in particular pays a fixed
    // ~18-20GB cost to build the genome index regardless of chunk size (index build
    // is not yet pre-built/shared across chunks, see TODO in A02_minimap2.nf), so its
    // per-chunk memory isn't reduced proportionally to chunk count. Verified against
    // a small (~4000 read) test chunk; re-check against a full-scale sample.
    // runFlexiplex's script reserves a fixed 8 threads for its pigz pipes (-p 2 + -p 6)
    // and gives flexiplex itself task.cpus - 8, so cpus must stay above 8.
    withName: splitFastq { cpus = 8; memory = '16 GB'; time = { 2.h * task.attempt } }
    withName: runFlexiplex { cpus = 12; memory = '32 GB'; time = { 6.h * task.attempt } }
    withName: runMinimap2 { cpus = 20; memory = '32 GB'; time = { 12.h * task.attempt } }
    withName: mergeBam { cpus = 8; memory = '32 GB'; time = { 2.h * task.attempt } }
    withName: runDeDup { cpus = 8; memory = '64 GB'; time = { 6.h * task.attempt } }
    withName: runFlair { cpus = 20; memory = '128 GB'; time = { 24.h * task.attempt } }
    withName: runTxRename { cpus = 1; memory = '24 GB'; time = { 2.h * task.attempt } }
    withName: runHtseq { cpus = 20; memory = '64 GB'; time = { 8.h * task.attempt } }
    withName: runLongshot { cpus = 16; memory = '64 GB'; time = { 24.h * task.attempt } }
    withName: runSQANTI3 { cpus = 8; memory = '64 GB'; time = { 12.h * task.attempt } }
    withName: runIsoSeQL { cpus = 8; memory = '64 GB'; time = { 8.h * task.attempt } }
}

singularity {
    enabled = params.use_container
    autoMounts = true
    runOptions = '--cleanenv --no-home'
}

profiles {
    sherlock {
        workDir = "${env('GROUP_SCRATCH')}/${env('USER')}/nextflow_work"
        process.time = { 6.h * task.attempt }
        process.errorStrategy = { task.exitStatus in [1,130,140,143,137,104,134,139] ? 'retry' : 'finish' }
        process.maxRetries = 5

        process {
            executor = 'slurm'
            clusterOptions = '-p normal,sfgf'
            scratch = '\$L_SCRATCH'
            // Container already set globally, no need to override

            // Sherlock-specific resource overrides
            withName: runFlexiplex { cpus = 12; memory = '32 GB'; time = { 2.h * task.attempt } }
            withName: runMinimap2 { cpus = 20; memory = '32 GB'; time = { 4.h * task.attempt } }
            withName: runDeDup { cpus = 8; memory = '64 GB'; time = { 6.h * task.attempt } }
            withName: runFlair { cpus = 20; memory = '128 GB'; time = { 12.h * task.attempt } }
            withName: runTxRename { cpus = 1; memory = '24 GB'; time = { 2.h * task.attempt } }
            withName: runHtseq { cpus = 20; memory = '64 GB'; time = { 8.h * task.attempt } }
            withName: runLongshot { cpus = 16; memory = '64 GB'; time = { 6.h * task.attempt } }
            withName: runSQANTI3 { cpus = 8; memory = '64 GB'; time = { 3.h * task.attempt } }
            withName: runIsoSeQL { cpus = 8; memory = '64 GB'; time = { 2.h * task.attempt } }
        }

        singularity {
            // Sherlock-specific bind mounts if needed
            runOptions = '--cleanenv --no-home'
            cacheDir = "${env('GROUP_SCRATCH')}/${env('USER')}/nf_sing_cache"

        }

        params {
            ref_dir = "/scratch/groups/hanleeji/vikas/reference/"
            vep_cache = "/scratch/groups/hanleeji/vikas/vep_dir/"
        }
    }

    local {
        process {
            executor = 'local'

            // Local profile resource overrides if different from default
            withName: runFlexiplex { cpus = 12; memory = '32 GB' }
            withName: runMinimap2 { cpus = 12; memory = '24 GB' }
            withName: runDeDup { cpus = 8; memory = '64 GB' }
            withName: runFlair { cpus = 16; memory = '96 GB' }
            withName: runTxRename { cpus = 1; memory = '24 GB' }
            withName: runHtseq { cpus = 20; memory = '64 GB' }
            withName: runLongshot { cpus = 8; memory = '32 GB' }
            withName: runSQANTI3 { cpus = 8; memory = '64 GB' }
            withName: runIsoSeQL { cpus = 8; memory = '64 GB' }
        }

        singularity {
            // Fugu-specific bind mounts
            runOptions = '--no-pid -B /mnt/ix1:/mnt/ix1 -B /mnt/ix2:/mnt/ix2 --cleanenv --no-home'
        }

        params {
            vep_cache = "/mnt/ix1/Resources/VariantAnnotation/VEP/GRCh38_v104"
            ref_dir = "/mnt/ix1/Projects/M102_241107_Multiome/00_resources/"
        }
    }
}
